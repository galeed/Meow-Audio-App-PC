{
  "name": "meow-audio-app-pc",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-64": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.galeed.meowaudioapp",
    "productName": "Meow Audio App",
    "win": {
      "target": "nsis",
      "icon": "app-icon.ico"
    },
    "files": [
      "index.html",
      "main.js",
      "sw.js",
      "app-icon.ico"
    ]
  }
}
